# PurpleMD — variables de entorno (ejemplo).
#
# Copiá este archivo a `.env` y reemplazá los valores: son falsos, nunca
# pongas secretos reales en el repo (`.gitignore` ya cubre `.env`).
# PurpleMD lee el entorno del proceso, no un archivo `.env` por su cuenta:
# exportalo antes de arrancar (`set -a; source .env; set +a`) o pasalo con
# `--env-file` de Docker/Podman. El detalle de cada una está en
# docs/AUTH.md y docs/DESARROLLO.md.

# --- Acceso con Google (opcional) ---
# Las tres juntas encienden la pantalla de acceso. Si falta alguna, la app
# arranca sin login (igual que siempre) y avisa en el log qué le falta.
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-ejemplo-falso-0123456789abcdef
# Clave con la que PurpleMD firma las cookies de sesión y los tokens del
# MCP (HMAC-SHA256). Generala una vez: openssl rand -hex 32. Rotarla cierra
# todas las sesiones y vence todos los tokens MCP.
PURPLEMD_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# off/0/no/false/apagado apaga la integración aunque haya credenciales;
# on/1/si/yes/true/encendido la pide y avisa si falta algo.
# Vacío = automático (según estén las credenciales).
PURPLEMD_AUTH=
# URI de callback registrada en Google Cloud; solo hace falta si Google
# exige una exacta. Vacío = se deriva del request (funciona en local).
#PURPLEMD_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Alcance OAuth. Vacío = el por defecto: openid, email, profile,
# drive.file y drive.appdata (ver docs/AUTH.md). Si lo cambiás, reemplazalo
# completo.
#PURPLEMD_GOOGLE_SCOPE=openid email profile https://www.googleapis.com/auth/drive.file
# Cualquier valor no vacío fuerza las cookies `Secure` aunque el request
# llegue por HTTP (útil detrás de un proxy que termina TLS).
#PURPLEMD_COOKIE_SECURE=1

# --- Almacenamiento ---
# filesystem (default), memory (demo efímera) o drive (Drive de cada
# cuenta; exige login con Google).
PURPLEMD_STORAGE=filesystem
# Raíz de datos: proyectos en {PURPLEMD_DIR}/projects/ sin sesión y en
# {PURPLEMD_DIR}/users/<sha256(sub)>/projects/ con sesión.
PURPLEMD_DIR=./local/purplemd
# Dónde quedan los tokens de Google (permisos 0600).
# Vacío = {PURPLEMD_DIR}/auth.
PURPLEMD_AUTH_DIR=

# --- Servidor MCP (/mcp) ---
# Solo sin credenciales de Google: token del admin que abre /mcp por la
# cabecera X-PurpleMD-Token. Con login encendido no sirve (responde 401):
# ahí el token lo emite la app, en «menú → Servidor MCP», y dura 90 días.
# Generalo con: openssl rand -hex 32
#PURPLEMD_MCP_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
